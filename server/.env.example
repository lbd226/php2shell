# ---- PHP2Shell ownership-scan backend configuration ----
# Copy to .env and fill in. The server fail-fasts on boot if required vars are missing.

# HTTP
PORT=8080
# Public origin of THIS API (used to build the email confirmation link). No trailing slash.
PUBLIC_BASE_URL=https://api.example.com
# Origin of the static hub (index.html). Used for CORS and the post-confirm redirect. No trailing slash.
HUB_URL=https://php2shell.example.com
# Comma-separated extra allowed CORS origins (optional; HUB_URL is always allowed).
CORS_ORIGINS=

# Storage
DB_PATH=./data/php2shell.db

# Secret key (>=32 random bytes, base64/hex) used to HMAC client IPs before storing. REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_KEY=

# Token / challenge lifetimes
EMAIL_TTL_MIN=30
DNS_TTL_HOURS=24
GRANT_TTL_MIN=30
GRANT_MAX_USES=3

# Passive scan
# Allow plain-http fallback when https fails (false = https only). Keep false in production.
HUB_ALLOW_HTTP=false
# Optional comma-separated trusted DNS resolver IPs (e.g. 1.1.1.1,8.8.8.8). Empty = system resolver.
RESOLVER_IPS=
# Disable IPv6 egress for the scanner entirely (recommended if you don't need it).
SCAN_DISABLE_IPV6=false

# ---- Email challenge (optional; the DNS-TXT challenge needs no email) ----
# Preferred: Resend (https://resend.com). In the Resend dashboard: (1) add & verify your
# sending domain (DNS records), (2) create an API key. Put the key here. MAIL_FROM must be
# an address on a domain you verified in Resend. The key is a secret — set it in your
# deployment's env/secrets, never commit it.
RESEND_API_KEY=
MAIL_FROM="PHP2Shell Verify <verify@yourdomain.com>"

# Alternative provider: raw SMTP via nodemailer (used only when RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: serve the static hub (../index.html) from this process. false = API only.
SERVE_STATIC=false

NODE_ENV=production
